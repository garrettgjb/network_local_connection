# Local energy agent — reads the Tesla gateway and Enphase Envoy over the LAN.
# Copy to .env and fill in. This file stays on the home network; the public
# dashboard never sees these values, only AGENT_TOKEN.

# Tesla Backup Gateway (TEG). Password is the "customer" login from the Tesla app.
POWERWALL_HOST=192.168.1.238
POWERWALL_EMAIL=
POWERWALL_PASSWORD=

# Enphase Envoy. Firmware D7+ authenticates with a JWT issued by Enphase's
# cloud against this Envoy's serial. Homeowner tokens last about a year;
# /energy reports the days remaining so it can be replaced before it lapses.
ENVOY_HOST=192.168.1.150
ENVOY_TOKEN=

# Shared secret the dashboard presents as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
AGENT_TOKEN=

# Interface and port to bind. Bind to the Tailscale address so the agent is
# reachable over the tailnet and nowhere else — not to 0.0.0.0.
BIND_ADDR=100.126.209.105
BIND_PORT=8099

TIMEOUT=15

# Marketplace search relay (gbanker.com's /market).
#
# OfferUp and Facebook refuse AWS address ranges, so the dashboard on EC2 can't
# run its searches. With this on, it sends them here and they go out over the
# house connection instead — a handful of anonymous page fetches every fifteen
# minutes. Anonymous search only: signed-in OfferUp calls are refused by
# src/Marketplace.php and stay on a machine someone is sitting at.
MARKETPLACE_RELAY=false
MARKETPLACE_TIMEOUT=25
# Refuse more than this per minute. Normal use is nowhere near it; the cap is
# there so a loop upstream can't turn this into a scraper.
MARKETPLACE_PER_MINUTE=60
